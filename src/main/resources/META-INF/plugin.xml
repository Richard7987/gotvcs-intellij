<idea-plugin>
    <id>dev.nezzontli.gotvcs</id>
    <name>Got</name>
    <vendor email="ale_bnes@tuta.com" url="https://github.com/Richard7987">ale</vendor>
    <description><![CDATA[
        Native version control support for Game of Trees (got) in the IDE.
        <ul>
            <li>Detects .got/ work trees automatically</li>
            <li>File status, native diff, and modified-lines gutter</li>
            <li>Commit and rollback from the Commit tool window</li>
            <li>File history and Update Project (got update / got fetch)</li>
            <li>Branch name widget and native Push dialog (Ctrl+Shift+K)</li>
            <li>Settings panel for the got binary path and SSH_AUTH_SOCK</li>
        </ul>
        See the <a href="https://github.com/Richard7987/gotvcs-intellij">README</a> for details on how each feature maps to the underlying got command.
    ]]></description>

    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <vcs name="got"
             vcsClass="dev.nezzontli.gotvcs.GotVcs"
             displayName="got"
             administrativeAreaName=".got"/>
        <vcsRootChecker implementation="dev.nezzontli.gotvcs.roots.GotVcsRootChecker"/>
        <vcsRepositoryCreator implementation="dev.nezzontli.gotvcs.repo.GotVcsRepositoryCreator"/>
        <applicationService serviceImplementation="dev.nezzontli.gotvcs.settings.GotSettingsState"/>
        <applicationConfigurable instance="dev.nezzontli.gotvcs.settings.GotConfigurable" displayName="got" parentId="vcs"/>
        <notificationGroup id="got" displayType="BALLOON"/>
        <projectService serviceImplementation="dev.nezzontli.gotvcs.repo.GotRepositoryManager"/>
        <projectService serviceImplementation="dev.nezzontli.gotvcs.log.GotVcsRefreshNotifier"/>
        <statusBarWidgetFactory id="got.branch.widget"
                                 implementation="dev.nezzontli.gotvcs.repo.GotBranchWidget$Factory"
                                 order="after CodeStyleStatusBarWidget"/>
        <pushSupport implementation="dev.nezzontli.gotvcs.push.GotPushSupport"/>
        <logProvider implementation="dev.nezzontli.gotvcs.log.GotVcsLogProvider"/>
    </extensions>

    <actions>
        <action id="Got.Commit.And.Send.Executor"
                class="dev.nezzontli.gotvcs.checkin.GotCommitAndSendExecutorAction">
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions"/>
        </action>
    </actions>
</idea-plugin>
